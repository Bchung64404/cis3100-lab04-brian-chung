# Copy to .env; replace every placeholder before use. Never commit .env.
MYSQL_DATABASE=lab_db
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-strong-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Create this account using the procedure in docs/database-setup.md.
MIGRATION_USER=lab_migrator
MIGRATION_PASSWORD=replace-with-a-different-strong-migration-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
